                              },
                              "type": "number",
                              "isFinite": true,
                              "format": null
                            },
                            "logCount": {
                              "def": {
                                "type": "number",
                                "checks": []
                              },
                              "type": "number",
                              "isFinite": true,
                              "format": null
                            },
                            "uploadId": {
                              "def": {
                                "type": "string"
                              },
                              "type": "string",
                              "minLength": null,
                              "maxLength": null,
                              "format": null
                            },
                            "sourceFormat": {
                              "def": {
                                "type": "enum",
                                "entries": {
                                  "csv": "csv",
                                  "json": "json",
                                  "txt": "txt"
                                }
                              },
                              "type": "enum",
                              "enum": {
                                "csv": "csv",
                                "json": "json",
                                "txt": "txt"
                              },
                              "options": [
                                "csv",
                                "json",
                                "txt"
                              ]
                            },
                            "ingestionType": {
                              "def": {
                                "type": "enum",
                                "entries": {
                                  "api": "api",
                                  "logstash": "logstash"
                                }
                              },
                              "type": "enum",
                              "enum": {
                                "api": "api",
                                "logstash": "logstash"
                              },
                              "options": [
                                "api",
                                "logstash"
                              ]
                            },
                            "indexingError": {
                              "def": {
                                "type": "nullable",
                                "innerType": {
                                  "def": {
                                    "type": "string"
                                  },
                                  "type": "string",
                                  "minLength": null,
                                  "maxLength": null,
                                  "format": null
                                }
                              },
                              "type": "nullable"
                            },
                            "uploadDate": {
                              "def": {
                                "type": "string",
                                "checks": [
                                  {
                                    "def": {
                                      "type": "string",
                                      "format": "datetime",
                                      "check": "string_format",
                                      "offset": false,
                                      "local": false,
                                      "precision": null,
                                      "pattern": {}
                                    },
                                    "type": "string"
                                  }
                                ]
                              },
                              "type": "string",
                              "minLength": null,
                              "maxLength": null,
                              "format": "datetime"
                            }
                          }
                        },
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/logs/{id}/status": {
      "get": {
        "tags": [
          "Logs"
        ],
        "summary": "Get current upload status and Elasticsearch log count",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "64f000000000000000000001"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Current file status and indexed log count",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/logs/{id}/download": {
      "get": {
        "tags": [
          "Logs"
        ],
        "summary": "Download a stored file",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "64f000000000000000000001"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Original uploaded file",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
