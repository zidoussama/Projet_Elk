{
  "openapi": "3.0.0",
  "info": {
    "title": "Monitoring Backend API",
    "version": "1.0.0",
    "description": "API documentation for the ELK, MongoDB and Redis monitoring backend"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Backend server"
    }
  ],
  "tags": [
    {
      "name": "Logs",
      "description": "Log file upload, validation, storage and download"
    }
  ],
  "components": {
    "schemas": {
      "File": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "64f000000000000000000001"
          },
          "filename": {
            "type": "string",
            "example": "logs.txt"
          },
          "type": {
            "type": "string",
            "enum": [
              "csv",
              "json",
              "txt"
            ],
            "example": "txt"
          },
          "size": {
            "type": "number",
            "example": 84
          },
          "status": {
            "type": "string",
            "enum": [
              "validated",
              "ingesting",
              "indexed",
              "failed"
            ],
            "example": "indexed"
          },
          "indexedCount": {
            "type": "number",
            "example": 2
          },
          "logCount": {
            "type": "number",
            "example": 2
          },
          "uploadId": {
            "type": "string",
            "example": "u_64f000000000000000000001"
          },
          "sourceFormat": {
            "type": "string",
            "enum": [
              "csv",
              "json",
              "txt"
            ],
            "example": "csv"
          },
          "ingestionType": {
            "type": "string",
            "enum": [
              "api",
              "logstash"
            ],
            "example": "api"
          },
          "indexingError": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "uploadDate": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-18T12:00:00.000Z"
          }
        },
        "required": [
          "id",
          "filename",
          "type",
          "size",
          "status",
          "indexedCount",
          "logCount",
          "uploadId",
          "sourceFormat",
          "ingestionType",
          "indexingError",
          "uploadDate"
        ]
      },
      "UploadResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "File uploaded and indexed successfully"
          },
          "file": {
            "$ref": "#/components/schemas/File"
          }
        },
        "required": [
          "message",
          "file"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "File not found"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/logs/upload": {
      "post": {
        "tags": [
          "Logs"
        ],
        "summary": "Upload and ingest a log file",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "CSV, JSON, or TXT file"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or unsupported file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/logs": {
      "get": {
