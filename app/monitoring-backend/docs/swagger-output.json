                                  "json": "json",
                                  "txt": "txt"
                                }
                              },
                              "type": "enum",
                              "enum": {
                                "csv": "csv",
                                "json": "json",
                                "txt": "txt"
                              },
                              "options": [
                                "csv",
                                "json",
                                "txt"
                              ]
                            },
                            "size": {
                              "def": {
                                "type": "number",
                                "checks": []
                              },
                              "type": "number",
                              "isFinite": true,
                              "format": null
                            },
                            "status": {
                              "def": {
                                "type": "enum",
                                "entries": {
                                  "validated": "validated",
                                  "ingesting": "ingesting",
                                  "indexed": "indexed",
                                  "failed": "failed"
                                }
                              },
                              "type": "enum",
                              "enum": {
                                "validated": "validated",
                                "ingesting": "ingesting",
                                "indexed": "indexed",
                                "failed": "failed"
                              },
                              "options": [
                                "validated",
                                "ingesting",
